@model List<SosialMedia>

<main class="main">

    <section id="team" class="team section">
        <div class="container">
            <div class="row gy-4">

                @foreach (var item in Model)
                {
                    <div class="col-lg-6">
                        <div class="team-member d-flex align-items-start">

                            <div class="pic">
                                <img src="~/assets/img/person/@item.TeamMemberId" class="img-fluid" alt="">
                            </div>

                            <div class="member-info">
                                <h4>Team Member</h4>

                                <div class="social">
                                    <a href="@item.TwitterUrl" target="_blank">
                                        <i class="bi bi-twitter-x"></i>
                                    </a>
                                    <a href="@item.FacebookUrl" target="_blank">
                                        <i class="bi bi-facebook"></i>
                                    </a>
                                    <a href="@item.InstagramUrl" target="_blank">
                                        <i class="bi bi-instagram"></i>
                                    </a>
                                    <a href="@item.LinkedInUrl" target="_blank">
                                        <i class="bi bi-linkedin"></i>
                                    </a>
                                </div>

                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </section>

</main>