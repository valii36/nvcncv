@model List<nvctask.Models.Portfolio>

<main class="main">
    <div class="page-title" data-aos="fade">
        <div class="container">
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="/">Home</a></li>
                    <li class="current">Portfolio</li>
                </ol>
            </nav>
            <h1>Portfolio</h1>
        </div>
    </div>

    <section id="portfolio" class="portfolio section">
        <div class="container">
            <div class="isotope-layout" data-default-filter="*" data-layout="masonry" data-sort="original-order">

                <ul class="portfolio-filters isotope-filters" data-aos="fade-up" data-aos-delay="100">
                    <li data-filter="*" class="filter-active">All</li>
                    @foreach (var category in ViewBag.Categories)
                    {
                        <li data-filter=".filter-@category.Title.ToLower().Replace(" ", "-")">@category.Title</li>
                    }
                </ul>

                <div class="row gy-4 isotope-container" data-aos="fade-up" data-aos-delay="200">
                    @foreach (var item in Model)
                    {
                        <div class="col-lg-4 col-md-6 portfolio-item isotope-item filter-@item.Category.Name.ToLower().Replace(" ", "-")">
                            <div class="portfolio-content h-100">
                                <img src="~/assets/img/portfolio/@item." class="img-fluid" alt="@item.Title">
                                    <div class="portfolio-info">
                                        <h4>@item.Title</h4>
                                        <p>@item.Category.Name</p>
                                        <a href="~/assets/img/portfolio/@item.ImageUrl" title="@item.Title" data-gallery="portfolio-gallery" class="glightbox preview-link"><i class="bi bi-zoom-in"></i></a>
                                    
                                        <a asp-controller="Portfolio" asp-action="Details" asp-route-id="@item.Id" title="More Details" class="details-link"><i class="bi bi-link-45deg"></i></a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </section>
    </main>